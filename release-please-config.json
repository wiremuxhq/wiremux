{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-v-in-tag": true,
  "packages": {
    ".": {
      "extra-files": [
        {
          "type": "toml",
          "path": "crates/wiremux/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "crates/wiremux/Cargo.toml",
          "jsonpath": "$.dependencies.wiremux-auth.version"
        },
        {
          "type": "toml",
          "path": "crates/wiremux-auth/Cargo.toml",
          "jsonpath": "$.package.version"
        }
      ]
    }
  }
}
