{
  "model": "gpt-5",
  "input": [
    {
      "role": "user",
      "content": [
        {
          "type": "input_text",
          "text": "list files in the workspace"
        }
      ]
    }
  ],
  "tools": [
    {
      "type": "namespace",
      "name": "mcp__fs",
      "description": "Filesystem tools",
      "tools": [
        {
          "type": "function",
          "name": "list_dir",
          "description": "List a directory",
          "parameters": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              }
            },
            "required": ["path"]
          }
        }
      ]
    }
  ],
  "store": true,
  "parallel_tool_calls": true
}
